---
// El text d'aquesta pàgina s'edita al panell: Pàgines → Documents.
// Els documents s'afegeixen i s'esborren al panell: Documents.
import Base from '../layouts/Base.astro';
import CapPagina from '../components/CapPagina.astro';
import Markdown from '../components/Markdown.astro';
import { getCollection } from 'astro:content';
import { pagina } from '../lib/pagina';
const { d, Content } = await pagina('documents');

// Ordre dels grups. Un tipus nou que no sigui aquí surt al final.
const ORDRE_GRUPS = ['Reglaments', 'Informes i processos participatius', 'Enquestes', 'Altres'];
const docs = await getCollection('documents');
const tipus = [...new Set(docs.map(x => x.data.tipus))].sort((a, b) => {
  const ia = ORDRE_GRUPS.indexOf(a), ib = ORDRE_GRUPS.indexOf(b);
  return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b, 'ca');
});
const grups = tipus.map(t => ({
  grup: t,
  items: docs.filter(x => x.data.tipus === t)
    .sort((a, b) => a.data.ordre - b.data.ordre || a.data.titol.localeCompare(b.data.titol, 'ca')),
}));
const format = (f) => (f.split('?')[0].split('.').pop() ?? '').toUpperCase();
---
<Base titol="Documents" descripcio={d.descripcio ?? d.titol}>
  <CapPagina sobre={d.sobre} titol={d.titol} entrada={d.entrada} to={d.to} />

  <div class="contenidor--mitja prosa" style="padding-top:1rem">
    <Content />

    {grups.map(g => (
      <>
        <h2>{g.grup}</h2>
        <ul class="docs">
          {g.items.map(x => (
            <li>
              <a href={x.data.fitxer}>{x.data.titol}</a>
              {x.data.quan && <span class="data">{x.data.quan}</span>}
              {x.data.descripcio && <p>{x.data.descripcio}</p>}
              {format(x.data.fitxer) && <span class="format">{format(x.data.fitxer)}</span>}
            </li>
          ))}
        </ul>
      </>
    ))}

    <Markdown text={d.textFinal} />
  </div>
</Base>
<style>
.docs { list-style: none; padding: 0; }
.docs li { padding: 1.1rem 0; border-bottom: 1px solid var(--vora); }
.docs a { font-family: var(--tipo-titol); font-size: 1.15rem; }
.docs p { margin: .35rem 0 .5rem; color: var(--tinta-suau); font-size: .96rem; }
.data { display: block; font-size: .82rem; color: var(--tinta-suau); }
.format { display: inline-block; font-size: .72rem; letter-spacing: .08em; background: var(--vora); color: var(--tinta); padding: .15rem .5rem; border-radius: 4px; }
.pendent { background: var(--crema); padding: .9rem 1.1rem; border-radius: var(--radi); color: var(--tinta-suau); }
</style>
