---
// El text d'aquesta pàgina s'edita al panell: Pàgines → Privacitat.
import Base from '../layouts/Base.astro';
import CapPagina from '../components/CapPagina.astro';
import { pagina } from '../lib/pagina';
const { d, Content } = await pagina('privacitat');
---
<Base titol="Privacitat" descripcio={d.descripcio ?? d.titol}>
  <CapPagina sobre={d.sobre} titol={d.titol} entrada={d.entrada} to={d.to} />
  <div class="contenidor--mitja prosa" style="padding-top:1rem">
    <Content />
  </div>
</Base>
