---
import Base from '../layouts/Base.astro';
import CapPagina from '../components/CapPagina.astro';
---
<Base titol="Crèdits" descripcio="Autoria dels continguts del web del Consell de Poble de Santa Pau.">
  <CapPagina titol="Crèdits" entrada="Autoria dels continguts i les eines d'aquest web." to="blau" />

  <div class="contenidor--mitja prosa" style="padding-top:1rem">

    <h2>Fotografies</h2>
    <p>Totes les fotografies de Santa Pau que apareixen en aquest web són obra de <strong>Jacint Garrigolas Coll</strong>.</p>

    <h2>Identitat gràfica</h2>
    <p>El logotip del Consell de Poble de Santa Pau és un disseny original encarregat pel mateix Consell.</p>

    <h2>Programari</h2>
    <p>Aquest web està fet amb <a href="https://astro.build">Astro</a> i s'allotja a Cloudflare Pages. Els mapes fan servir <a href="https://maplibre.org">MapLibre</a> amb cartografia d'<a href="https://openfreemap.org">OpenFreeMap</a> i <a href="https://openmaptiles.org">OpenMapTiles</a>, generada a partir de dades d'<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> sota llicència ODbL.</p>

    <h2>Titularitat</h2>
    <p>Aquest web és del <strong>Consell de Poble de Santa Pau</strong>.</p>
  </div>
</Base>
