---
import Base from '../layouts/Base.astro';
import Mapa from '../components/Mapa.astro';
import CapPagina from '../components/CapPagina.astro';
import { getCollection } from 'astro:content';
const rutes = await getCollection('rutes', r => r.data.visible);
const capes = rutes.map(r => ({ id: r.id, nom: r.data.nom, gpx: r.data.gpx, color: r.data.color }));
---
<Base titol="Mapa del terme" descripcio="Mapa del terme municipal de Santa Pau amb els punts i les rutes que interessen al Consell de Poble.">
  <CapPagina sobre="El territori" titol="Mapa del terme" to="blau"
    entrada="Un mapa per situar-hi el que anem trobant: fonts, equipaments, camins, elements de patrimoni i tot allò sobre el que treballin els cercles." />

  <div class="contenidor" style="margin-top:2rem">
    <Mapa capes={capes} />
  </div>

  <div class="contenidor--mitja prosa" style="margin-top:2.8rem">
    <h2>Coneixes un lloc que hi hauria de ser?</h2>
    <p>El mapa es construeix entre tots. Si saps d'una font, d'un camí o d'un element que hi hauria de constar, escriu a <a href="mailto:conselldepoble@santapau.cat">conselldepoble@santapau.cat</a> dient on és — amb una descripció n'hi ha prou, ja el situarem.</p>
    <p>Si tens un fitxer GPX d'una ruta o d'un recull de punts, encara millor: es pot afegir tal com està.</p>
  </div>
</Base>
<style>
.entrada { font-size: 1.15rem; color: var(--tinta-suau); max-width: 54ch; }
</style>
