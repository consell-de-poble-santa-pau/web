---
// El text d'aquesta pàgina s'edita al panell: Pàgines → El Consell.
import Base from '../layouts/Base.astro';
import CapPagina from '../components/CapPagina.astro';
import { pagina } from '../lib/pagina';
const { d, Content } = await pagina('el-consell');
---
<Base titol="El Consell" descripcio={d.descripcio ?? d.titol}>
  <CapPagina sobre={d.sobre} titol={d.titol} entrada={d.entrada} to={d.to} />

  <div class="contenidor--mitja prosa" style="padding-top:1rem">
    <Content />
  </div>

  {(d.membres?.length || d.ajuntament?.length) && (
    <div class="contenidor" style="margin-top:3rem">
      <div class="membres">
        <h2 id="el-cercle-de-coordinacio">{d.coordinacioTitol ?? 'El Cercle de Coordinació'}</h2>
        {d.coordinacioNota && <p class="peu-nota">{d.coordinacioNota}</p>}
        {d.membres?.length > 0 && (<>
          <p class="etiqueta">Persones del poble, escollides en eleccions sense candidatura</p>
          <ul>{d.membres.map(n => <li>{n}</li>)}</ul>
        </>)}
        {d.ajuntament?.length > 0 && (<>
          <p class="etiqueta">Per part de l'Ajuntament</p>
          <ul>{d.ajuntament.map(n => <li class={/vacant/i.test(n) ? 'vacant' : undefined}>{n}</li>)}</ul>
        </>)}
        {d.coordinacioPeu && <p class="peu-nota">{d.coordinacioPeu}</p>}
      </div>
    </div>
  )}
</Base>

<style>
.lede { font-size: 1.2rem; color: var(--tinta-suau); }
.membres { background: var(--crema); border-radius: var(--radi); padding: 2rem; max-width: var(--amplada-text); }
.membres h2 { margin-top: 0; }
.etiqueta { text-transform: uppercase; letter-spacing: .1em; font-size: .74rem; color: var(--terra); font-weight: 600; margin: 1.4rem 0 .4rem; }
.membres ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .3rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
.membres li { padding: .25rem 0; }
.vacant { color: var(--tinta-suau); font-style: italic; }
.peu-nota { font-size: .9rem; color: var(--tinta-suau); }
</style>
