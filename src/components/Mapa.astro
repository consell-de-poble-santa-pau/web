---
import { CATEGORIES } from '../dades/categories.js';
const { alcada = '560px' } = Astro.props;
const llista = Object.entries(CATEGORIES);
---

<div class="mapa-caixa">
  <div class="mapa-plec">
    <div id="mapa" style={`height:${alcada}`} role="application"
         aria-label="Mapa del terme municipal de Santa Pau"></div>

    <fieldset class="capes">
      <legend>Capes</legend>
      {llista.map(([clau, cat]) => (
        <label>
          <input type="checkbox" checked={clau !== 'habitatge'} data-capa={clau} />
          <span class="mostra" style={`--c:${cat.color}`}></span>
          {cat.etiqueta}
        </label>
      ))}
      <label class="capes-rutes">
        <input type="checkbox" checked data-capa="rutes" />
        <span class="mostra mostra-linia"></span>
        Rutes
      </label>
    </fieldset>
  </div>

  <p class="mapa-nota">
    Cartografia de <a href="https://maptoolkit.com/">Maptoolkit</a> amb dades
    d'<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>.
    En carregar el mapa es fan peticions als seus servidors.
  </p>
</div>

<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { Map, Popup, NavigationControl, ScaleControl, FullscreenControl } from 'maplibre-gl';
  import { CATEGORIES } from '../dades/categories.js';

  // ─────────────────────────────────────────────────────────────────────
  // NO TOQUIS AIXÒ: és l'estil de base que ja fas servir ara mateix.
  // Enganxa-hi la URL o l'objecte d'estil de Maptoolkit que tens al fitxer vell.
  // const ESTIL = 'ENGANXA-HI-EL-TEU-ESTIL-ACTUAL';
  const ESTIL = {
    version: 8,
    sources: {
      osm: {
        type: 'raster',
        tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
        tileSize: 256,
        attribution: '© OpenStreetMap',
      },
    },
    layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
  };
  // ─────────────────────────────────────────────────────────────────────

  const MIDA = 32;   // diàmetre del marcador, en píxels de pantalla
  const RATIO = 2;   // el dibuixem al doble per a pantalles retina
  const GLIF = 1.15; // com d'gran surt la silueta dins del cercle

  // Pinta un marcador: cercle de color, vora blanca, silueta blanca a dins.
  function pintaMarcador({ color, icona }) {
    const c = document.createElement('canvas');
    c.width = c.height = MIDA * RATIO;
    const g = c.getContext('2d');
    g.scale(RATIO, RATIO);

    g.beginPath();
    g.arc(MIDA / 2, MIDA / 2, MIDA / 2 - 3, 0, Math.PI * 2);
    g.fillStyle = color;
    g.fill();
    g.lineWidth = 2.5;
    g.strokeStyle = '#fff';
    g.stroke();

    g.translate(MIDA / 2 - 7.5 * GLIF, MIDA / 2 - 7.5 * GLIF); // la icona fa 15×15
    g.scale(GLIF, GLIF);
    g.fillStyle = '#fff';
    g.fill(new Path2D(icona));

    return g.getImageData(0, 0, c.width, c.height);
  }

  const mapa = new Map({
    container: 'mapa',
    style: ESTIL,
    center: [2.5699, 42.145],
    zoom: 12.5,
    attributionControl: { compact: true },
  });

  mapa.addControl(new NavigationControl({ showCompass: false }), 'top-right');
  mapa.addControl(new FullscreenControl(), 'top-right');
  mapa.addControl(new ScaleControl({ unit: 'metric' }));
  mapa.scrollZoom.disable(); // no segrestar el desplaçament de la pàgina

  mapa.on('load', () => {
    // ── Rutes: primer, perquè quedin per sota dels punts ──────────────
    mapa.addSource('rutes', { type: 'geojson', data: '/dades/rutes.geojson' });

    mapa.addLayer({
      id: 'rutes-fons', source: 'rutes', type: 'line',
      layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': '#fff', 'line-width': 6, 'line-opacity': 0.8 },
    });
    mapa.addLayer({
      id: 'rutes-linia', source: 'rutes', type: 'line',
      layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': '#A03030', 'line-width': 2.5 },
    });

    // ── Punts: una capa per categoria, per poder-les encendre i apagar ─
    mapa.addSource('punts', { type: 'geojson', data: '/dades/punts.geojson' });

    for (const [clau, cat] of Object.entries(CATEGORIES)) {
      mapa.addImage(clau, pintaMarcador(cat), { pixelRatio: RATIO });

      mapa.addLayer({
        id: `punts-${clau}`,
        source: 'punts',
        type: 'symbol',
        filter: ['==', ['get', 'categoria'], clau],
        layout: {
          'icon-image': clau,visibility: clau === 'habitatge' ? 'none' : 'visible',
          'icon-size': ['interpolate', ['linear'], ['zoom'], 11, 0.55, 15, 1],
          'icon-allow-overlap': false,   // ← aquí és on es descongestiona sol
          'icon-padding': 4,
          'text-field': ['get', 'nom'],
          'text-font': ['Noto Sans Regular'], // ha d'existir a l'estil de base
          'text-size': 11,
          'text-offset': [0, 1.1],
          'text-anchor': 'top',
          'text-optional': true,
          'text-max-width': 9,
        },
        paint: {
          'text-color': '#2A2A2A',
          'text-halo-color': '#fff',
          'text-halo-width': 1.5,
        },
        minzoom: 11,
      });
    }

    // ── Fitxa del punt ────────────────────────────────────────────────
    const capesPunt = Object.keys(CATEGORIES).map((c) => `punts-${c}`);

    mapa.on('click', (e) => {
      const [t] = mapa.queryRenderedFeatures(e.point, { layers: capesPunt });
      if (!t) return;
      const p = t.properties;
      new Popup({ offset: 18 })
        .setLngLat(t.geometry.coordinates)
        .setHTML(
          `<strong>${p.nom}</strong><br><small>${CATEGORIES[p.categoria].etiqueta}</small>` +
          (p.descripcio ? `<p>${p.descripcio}</p>` : '')
        )
        .addTo(mapa);
    });

    mapa.on('mouseenter', () => (mapa.getCanvas().style.cursor = ''));
    for (const capa of capesPunt) {
      mapa.on('mouseenter', capa, () => (mapa.getCanvas().style.cursor = 'pointer'));
      mapa.on('mouseleave', capa, () => (mapa.getCanvas().style.cursor = ''));
    }

    // ── Llegenda ──────────────────────────────────────────────────────
    for (const casella of document.querySelectorAll('.capes input')) {
      casella.addEventListener('change', () => {
        const v = casella.checked ? 'visible' : 'none';
        const capes = casella.dataset.capa === 'rutes'
          ? ['rutes-fons', 'rutes-linia']
          : [`punts-${casella.dataset.capa}`];
        for (const c of capes) mapa.setLayoutProperty(c, 'visibility', v);
      });
    }
  });

  mapa.on('error', (e) => console.error('Mapa:', e.error?.message ?? e));
</script>

<style is:global>
  .maplibregl-popup-content {
    font-family: var(--tipo); font-size: .92rem; border-radius: 8px; padding: .7rem .9rem;
  }
  .maplibregl-popup-content p { margin: .4rem 0 0; }
  .maplibregl-popup-content small { color: #666; }
</style>

<style>
  .mapa-caixa { border: 1px solid var(--vora); border-radius: var(--radi);
    overflow: hidden; background: #fff; }
  .mapa-plec { position: relative; }
  #mapa { width: 100%; }

  .capes { position: absolute; top: .7rem; left: .7rem; z-index: 1;
    margin: 0; padding: .6rem .8rem .7rem; border: 1px solid var(--vora);
    border-radius: 8px; background: rgba(255,255,255,.94);
    backdrop-filter: blur(3px); box-shadow: 0 1px 6px rgba(0,0,0,.18);
    max-height: calc(100% - 1.4rem); overflow-y: auto; }
  .capes legend { padding: 0 .3rem; font-size: .7rem; letter-spacing: .08em;
    text-transform: uppercase; color: var(--tinta-suau); }
  .capes label { display: flex; align-items: center; gap: .45rem;
    font-size: .82rem; line-height: 1.9; cursor: pointer; }
  .capes input { accent-color: #444; margin: 0; }
  .capes-rutes { margin-top: .35rem; padding-top: .35rem;
    border-top: 1px solid var(--vora); }

  .mostra { width: 12px; height: 12px; border-radius: 50%;
    background: var(--c); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.2); }
  .mostra-linia { width: 14px; height: 3px; border-radius: 2px;
    background: #A03030; border: 0; box-shadow: 0 0 0 1px #fff; }

  .mapa-nota { margin: 0; padding: .6rem .9rem; font-size: .8rem;
    color: var(--tinta-suau); border-top: 1px solid var(--vora); }

  @media (max-width: 640px) {
    .capes { font-size: .78rem; padding: .5rem .6rem; }
  }
</style>
