---
// Capçalera de pàgina amb fons de color. Unifica totes les pàgines interiors.
const { sobre, titol, entrada, to = 'verd' } = Astro.props;
---
<section class={`capp capp--${to}`}>
  <svg class="capp__turons" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,120 C240,60 460,150 720,110 C960,74 1180,148 1440,96 L1440,200 L0,200 Z" fill="rgba(255,255,255,.05)"/>
    <path d="M0,158 C280,118 540,178 820,150 C1080,124 1250,166 1440,140 L1440,200 L0,200 Z" fill="rgba(255,255,255,.05)"/>
  </svg>
  <div class="contenidor--mitja capp__int">
    {sobre && <p class="capp__sobre">{sobre}</p>}
    <h1>{titol}</h1>
    {entrada && <p class="capp__entrada">{entrada}</p>}
    <slot />
  </div>
  <svg class="capp__onada" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,28 C280,-6 520,52 800,32 C1060,14 1240,48 1440,22 L1440,60 L0,60 Z" fill="var(--paper)"/>
  </svg>
</section>
<style>
.capp { position: relative; color: #fff; padding: clamp(2.6rem, 5vw, 4.2rem) 0 clamp(3rem, 5vw, 4rem); overflow: hidden; }
.capp--verd  { background: linear-gradient(135deg, #00521A 0%, #00682D 55%, #157A45 100%); }
.capp--blau  { background: linear-gradient(135deg, #1B2F40 0%, #21384A 55%, #2F5670 100%); }
.capp--terra { background: linear-gradient(135deg, #8E3C3C 0%, #A84848 55%, #C4614C 100%); }
.capp__turons { position: absolute; inset: auto 0 0 0; width: 100%; height: 100%; }
.capp__onada { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(26px, 3.4vw, 52px); display: block; }
.capp__int { position: relative; }
.capp h1 { margin: 0 0 .35em; color: #fff; }
.capp__sobre { display: inline-flex; align-items: center; gap: .5rem; text-transform: uppercase;
  letter-spacing: .14em; font-size: .74rem; font-weight: 700; color: var(--crema); margin: 0 0 .9rem; }
.capp__sobre::before { content: ""; width: 1.6rem; height: 2px; background: var(--sol); border-radius: 2px; }
.capp__entrada { max-width: 56ch; font-size: 1.14rem; color: rgba(255,255,255,.86); margin: 0; }
</style>
