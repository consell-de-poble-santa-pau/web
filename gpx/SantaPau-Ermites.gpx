	<!-- Afegida 2026-08-24. Capella de la baronia, dins la torre de
	     l'homenatge del castell. Coordenada del castell segons l'Inventari
	     del Patrimoni del Consell Comarcal de la Garrotxa. -->
	<wpt lat="42.14474" lon="2.57159">
		<name>Capella de Sant Antoni i Sant Honorat</name>
		<desc>XIV, 1766 - Castell. Capella de la baronia, a la planta baixa de la torre de l homenatge. Hi hagueren el retaule d alabastre de 1340 i la veracreu de 1391.</desc>
		<sym>Church</sym>
		<type>ermita</type>
	</wpt>
	
	<!-- Afegit el 25-08-2026. Es dins el Mas les Feixes de Sant Marti,
	     segons informacio del poble. Coordenada del mas, al nostre
	     SantaPau-Habitatges.gpx: cal ajustar-la sobre el terreny. -->
	<wpt lat="42.16287" lon="2.56494">
		<name>Oratori de les Feixes</name>
		<desc>XVI - Sant Marti. Oratori amb un Crist del segle XVI, dins el Mas les Feixes. Coordenada del mas.</desc>
		<sym>Church</sym>
		<type>ermita</type>
	</wpt>
	
	<!-- Afegides el 25-08-2026. Son les tres capelles de mas que
	     l'enciclopedia documenta al terme. La coordenada es la del mas al
	     nostre SantaPau-Habitatges.gpx: cal ajustar-la sobre el terreny,
	     perque una capella de mas no sol ser al mig de la casa. -->
	<wpt lat="42.14532" lon="2.58816">
		<name>Capella de Sant Antoni de Padua</name>
		<desc>Els Arcs. Capella del mas Pratdavall. Coordenada de Can Prat de Vall: cal confirmar que Pratdavall es aquest mas, perque la casa consta del 1905.</desc>
		<sym>Church</sym>
		<type>ermita</type>
	</wpt>
	
